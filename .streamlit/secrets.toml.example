# Macromancer — secrets template
# ---------------------------------------------------------------------------
# On Streamlit Community Cloud: open your app -> "⋮" -> Settings -> Secrets and
# paste the keys you want (TOML format, same as below). The app bridges these
# into environment variables for its embedded backend automatically.
#
# Locally: copy this file to  .streamlit/secrets.toml  (git-ignored) OR export
# the same names as environment variables / put them in a .env file.
# ---------------------------------------------------------------------------

# --- AI meal-plan chat (pick ONE hosted provider) --------------------------
# Groq is free + fast and is the default provider — sign up at
# https://console.groq.com (no credit card) and paste the key below.
LLM_API_KEY = "gsk_your_groq_key_here"

# Optional: point at a different OpenAI-compatible provider.
#   OpenAI:      LLM_BASE_URL="https://api.openai.com/v1/chat/completions",     LLM_MODEL="gpt-4o-mini"
#   OpenRouter:  LLM_BASE_URL="https://openrouter.ai/api/v1/chat/completions",  LLM_MODEL="meta-llama/llama-3.3-70b-instruct"
# LLM_BASE_URL = "https://api.groq.com/openai/v1/chat/completions"
# LLM_MODEL    = "llama-3.3-70b-versatile"

# --- Nearby restaurants (Nutritionix) --------------------------------------
# Free signup at https://developer.nutritionix.com (no credit card).
NUTRITIONIX_APP_ID  = "your_app_id"
NUTRITIONIX_API_KEY = "your_api_key"
